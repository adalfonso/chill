generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Genre {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  tracks     Track[]
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Album {
  id         Int       @id @default(autoincrement())
  title      String
  year       Int?
  album_art  AlbumArt?
  tracks     Track[]
  artist_id  Int?
  artist     Artist?   @relation(fields: [artist_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  @@unique([title, year, artist_id])
}

model AlbumArt {
  id         Int      @id @default(autoincrement())
  filename   String   @unique
  format     String
  data       Bytes
  type       String
  checksum   String
  album      Album    @relation(fields: [album_id], references: [id], onDelete: Cascade)
  album_id   Int      @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([album_id])
  @@index([checksum])
}

model Artist {
  id                  Int      @id @default(autoincrement())
  name                String   @unique
  tracks              Track[]  @relation("TrackArtist")
  album_artist_tracks Track[]  @relation("TrackAlbumArtist")
  albums              Album[]
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt
}

model Track {
  id              Int      @id @default(autoincrement())
  title           String
  path            String   @unique
  number          Int?
  disc_number     Int
  duration        Decimal
  file_size       Int
  file_type       String
  file_modified   DateTime
  audio_checksum  String?
  bitrate         Int
  sample_rate     Int
  bits_per_sample Int

  genre    Genre? @relation(fields: [genre_id], references: [id])
  genre_id Int?

  artist    Artist? @relation("TrackArtist", fields: [artist_id], references: [id])
  artist_id Int?

  album_artist    Artist? @relation("TrackAlbumArtist", fields: [album_artist_id], references: [id], onUpdate: Restrict, onDelete: SetNull)
  album_artist_id Int?

  album    Album? @relation(fields: [album_id], references: [id])
  album_id Int?

  playlist_items PlaylistTrack[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([album_id])
  @@index([artist_id])
  @@index([album_artist_id])
  @@index([genre_id])
  @@index([audio_checksum])
}

model Playlist {
  id         Int             @id @default(autoincrement())
  title      String          @unique
  tracks     PlaylistTrack[]
  created_at DateTime        @default(now())
  updated_at DateTime        @default(now()) @updatedAt
}

model PlaylistTrack {
  id          Int      @id @default(autoincrement())
  index       Int
  track       Track    @relation(fields: [track_id], references: [id])
  track_id    Int
  playlist    Playlist @relation(fields: [playlist_id], references: [id])
  playlist_id Int
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@index([track_id])
  @@index([playlist_id])
  @@map("PlaylistTrack")
}

model Scan {
  id              Int        @id @default(autoincrement())
  completed_at    DateTime?
  status          ScanStatus @default(Active)
  records_written Int        @default(0)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now()) @updatedAt
}

enum ScanStatus {
  Active
  Failed
  Completed
  Aborted
}

model Invitation {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  email      String   @unique
}

model User {
  id             Int            @id @default(autoincrement())
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now()) @updatedAt
  email          String         @unique
  type           UserType
  settings       UserSettings?
  login_sessions LoginSession[]
}

enum UserType {
  User
  Admin
}

model UserSettings {
  id            Int          @id @default(autoincrement())
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now()) @updatedAt
  audio_quality AudioQuality @default(Original)
  user          User         @relation(fields: [user_id], references: [id])
  user_id       Int          @unique

  @@index([user_id])
}

enum AudioQuality {
  Original
  High
  Low
}

enum RenditionTier {
  High
  Low
}

enum RenditionJobStatus {
  Pending
  Running
  Done
  Failed
}

model Rendition {
  id             Int           @id @default(autoincrement())
  audio_checksum String
  tier           RenditionTier
  file_size      Int
  target_kbps    Int?
  created_at     DateTime      @default(now())

  @@unique([audio_checksum, tier])
  @@index([audio_checksum])
}

model RenditionJob {
  id             Int                @id @default(autoincrement())
  audio_checksum String
  tier           RenditionTier
  status         RenditionJobStatus @default(Pending)
  priority       Int                @default(0)
  enqueued_at    DateTime           @default(now())
  started_at     DateTime?
  finished_at    DateTime?
  error          String?
  source_codec   String?
  source_bitrate Int?
  in_bytes       Int?
  out_bytes      Int?

  @@unique([audio_checksum, tier])
  @@index([status, priority, enqueued_at])
}

model LoginSession {
  id                  Int            @id @default(autoincrement())
  user_id             Int
  user                User           @relation(fields: [user_id], references: [id])
  device_id           String
  device_label        String         @db.VarChar(64)
  last_seen_at        DateTime       @default(now())
  revoked_at          DateTime?
  idle_expires_at     DateTime
  absolute_expires_at DateTime
  refresh_tokens      RefreshToken[]
  created_at          DateTime       @default(now())
  updated_at          DateTime       @default(now()) @updatedAt

  @@unique([user_id, device_id])
  @@index([user_id])
  @@index([revoked_at])
}

model RefreshToken {
  id                Int           @id @default(autoincrement())
  token_hash        String        @unique
  login_session_id  Int
  login_session     LoginSession  @relation(fields: [login_session_id], references: [id], onDelete: Cascade)
  rotated_at        DateTime?
  rotated_to_id     Int?          @unique
  rotated_to        RefreshToken? @relation("TokenRotation", fields: [rotated_to_id], references: [id], onDelete: SetNull)
  rotated_from      RefreshToken? @relation("TokenRotation")
  expires_at        DateTime
  issued_ip         String
  issued_user_agent String
  created_at        DateTime      @default(now())
  updated_at        DateTime      @default(now()) @updatedAt

  @@index([login_session_id])
}
